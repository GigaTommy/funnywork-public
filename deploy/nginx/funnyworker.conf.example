# Install inside nginx's http context. Replace domain and certificate paths.
# Backend services must remain bound to loopback on this same host.
limit_req_zone $binary_remote_addr zone=fw_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=fw_account:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=fw_connections:10m;
# Excludes query strings, authorization headers and request bodies.
log_format fw_safe '$remote_addr $request_method $uri $status $request_time';

server {
    listen 443 ssl;
    server_name worker.example.com;
    ssl_certificate /etc/funnyworker/tls/fullchain.pem;
    ssl_certificate_key /etc/funnyworker/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=86400" always;
    access_log /var/log/nginx/funnyworker-access.log fw_safe;
    client_max_body_size 3m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_conn fw_connections 20;
    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    location = /api/account/login {
        limit_except POST { deny all; }
        limit_req zone=fw_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/session {
        limit_except GET { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/startup {
        limit_except POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/logout {
        limit_except POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    # Account-scoped signed model distribution. Credentials stay encrypted for
    # the requesting device; the backend enforces account and device ownership.
    location = /api/account/model/signer {
        limit_except GET { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/model/publication {
        limit_except POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/model/receipt {
        limit_except POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    # Authenticated account-scoped organization defaults and application receipts.
    location = /api/account/policy {
        limit_except GET { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/policy/receipt {
        limit_except POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    # Account-scoped desktop/mobile synchronization. The backend authenticates
    # each request and enforces account/device ownership; management stays private.
    # Independent phone chats use the business admission queue and streaming proxy.
    location = /api/account/chats {
        limit_except GET POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location ^~ /api/account/chats/ {
        limit_except GET POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_buffering off;
        proxy_read_timeout 660s;
    }

    # Large model context is restricted to the authenticated inference gateway.
    location ^~ /api/account/inference/ {
        client_max_body_size 16m;
        limit_except GET POST { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_buffering off;
        proxy_read_timeout 660s;
    }
    location ^~ /api/account/sync/ {
        limit_except GET POST DELETE { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location = /api/account/push {
        limit_except GET { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    location ^~ /api/account/push/installations/ {
        limit_except PUT DELETE { deny all; }
        limit_req zone=fw_account burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }
    # Management and unrelated APIs stay private.
    # Add the actual VPN source CIDR here if required. Never use allow all.
    location / {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8765;
    }
}
# No plaintext HTTP listener: firewall must also block direct backend access.
