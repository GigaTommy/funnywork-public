# APNs provider authentication. Keep the .p8 private key outside the repository.
# Leave all three fields blank to disable the provider.
FUNNYWORK_APNS_TEAM_ID=
FUNNYWORK_APNS_KEY_ID=
FUNNYWORK_APNS_KEY_FILE=
# Must match the signed iOS application's bundle identifier.
FUNNYWORK_APNS_TOPIC=com.funnyworker.ios
