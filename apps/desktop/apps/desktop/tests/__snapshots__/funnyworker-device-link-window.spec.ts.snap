// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`expires the image, intercepts refresh, denies external navigation, and cancels on close 1`] = `"<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"><style>body{margin:0;background:#F8F6F1;color:#292724;font:15px system-ui;text-align:center}main{padding:24px}h1{font-size:22px;font-weight:600}img{width:320px;max-width:100%;border-radius:12px}p{line-height:1.5;color:#69645c}a{display:inline-block;padding:12px 22px;color:inherit;border:1px solid #DDD9D2;border-radius:24px;text-decoration:none}a:focus-visible{outline:2px solid currentColor}@media(prefers-color-scheme:dark){body{background:#201F1D;color:#EEEAE2}p{color:#b7b0a5}a{border-color:#45413C}}</style></head><body><main><h1>连接手机</h1><img alt="连接手机" src="<local-qr>"><p>使用 FunnyWork 扫描。二维码两分钟内有效。</p><a href="https://connect.funnywork.invalid/refresh">刷新二维码</a></main></body></html>"`;

exports[`explains the HTTPS requirement without creating a phone code on a local HTTP server 1`] = `"<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"><style>body{margin:0;background:#F8F6F1;color:#292724;font:15px system-ui;text-align:center}main{padding:24px}h1{font-size:22px;font-weight:600}img{width:320px;max-width:100%;border-radius:12px}p{line-height:1.5;color:#69645c}a{display:inline-block;padding:12px 22px;color:inherit;border:1px solid #DDD9D2;border-radius:24px;text-decoration:none}a:focus-visible{outline:2px solid currentColor}@media(prefers-color-scheme:dark){body{background:#201F1D;color:#EEEAE2}p{color:#b7b0a5}a{border-color:#45413C}}</style></head><body><main><h1>连接手机</h1><p>连接手机需要 HTTPS 服务地址。请连接已配置 HTTPS 的服务后重试。</p><a href="https://connect.funnywork.invalid/refresh">刷新二维码</a></main></body></html>"`;
