exports[`delivered receipt distinguishes merged sources from candidate acceptance 1`] = `"<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; form-action https://feedback.funnywork.invalid"><style>body{margin:0;background:#F8F6F1;color:#292724;font:14px system-ui}main{padding:24px}h1{font-size:22px}h2{font-size:18px}p{white-space:pre-wrap;line-height:1.55}label{display:block;margin:12px 0}input,textarea,select{box-sizing:border-box;width:100%;margin-top:6px;padding:9px;border:1px solid #DDD9D2;border-radius:7px;background:#FFFDFA;color:inherit;font:inherit}button{padding:10px 18px;background:#292724;color:white;border:0;border-radius:7px}button:disabled{opacity:.45}a{color:inherit}nav{display:flex;gap:16px;margin:16px 0}article,.note{border-bottom:1px solid #DDD9D2;padding:12px 0}article p{margin-bottom:0}@media(prefers-color-scheme:dark){body{background:#201F1D;color:#EEEAE2}input,textarea,select{background:#2A2825;border-color:#45413C}button{background:#EEEAE2;color:#24221F}}</style></head><body><main><h1>问题反馈</h1><p>描述实际遇到的问题，请勿填写密码或私有凭据。</p><nav><a href="https://feedback.funnywork.invalid/new">新建反馈</a><a href="https://feedback.funnywork.invalid/history">我的反馈</a></nav><p role="status"></p><h2>已合并并关闭关联问题</h2><p></p><a href="https://feedback.funnywork.invalid/pr">查看 PR</a> · <a href="https://feedback.funnywork.invalid/refresh">刷新</a></main></body></html>"`;

